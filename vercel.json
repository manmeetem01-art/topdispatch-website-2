{
 "cleanUrls": true,
 "trailingSlash": true,
 "redirects": [
  {
   "source": "/ServicesPage",
   "destination": "/services/",
   "permanent": true
  },
  {
   "source": "/AboutPage",
   "destination": "/about/",
   "permanent": true
  },
  {
   "source": "/ReviewsPage",
   "destination": "/reviews/",
   "permanent": true
  },
  {
   "source": "/FAQPage",
   "destination": "/faq/",
   "permanent": true
  },
  {
   "source": "/IndustriesPage",
   "destination": "/industries/",
   "permanent": true
  },
  {
   "source": "/ContactPage",
   "destination": "/contact/",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ]
}